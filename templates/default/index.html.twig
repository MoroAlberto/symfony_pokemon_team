{% extends 'base.html.twig' %}

{% block body %}
    <div class="p-4 p-md-5 bg-body rounded-3 shadow-sm">
        <h1 class="display-5 fw-bold">Welcome Trainer!</h1>
        <p class="col-lg-8 fs-5 text-body-secondary">A new Pokémon tournament is coming soon and you must create a
            strong team to try to excel at the competition!</p>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('create_team') }}" class="btn btn-danger btn-lg">Create new team</a>
            <a href="{{ path('list_teams') }}" class="btn btn-outline-secondary btn-lg">List of teams</a>
        </div>
    </div>
{% endblock %}
